{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-office.dev/spec/facts.schema.json",
  "title": "dsh-office fact table v1",
  "description": "What `dsh-office extract` reports about a document. This is the panel's data source and the verifier's baseline.",
  "type": "object",
  "required": ["schema", "template", "paragraphs", "tables", "slots", "figures", "stats"],
  "properties": {
    "schema": { "const": "dsh-office/facts@1" },
    "template": {
      "type": "object",
      "required": ["path", "content_sha256", "page"],
      "properties": {
        "path": { "type": "string" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "page": {
          "type": "object",
          "properties": {
            "width_twip": { "type": ["integer", "null"] },
            "height_twip": { "type": ["integer", "null"] },
            "margin_twip": { "type": "object" }
          }
        }
      }
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^p\\d+$" },
          "text": { "type": "string", "description": "Run-merged text as a reader sees it." },
          "sz_pt": { "type": ["number", "null"], "description": "Resolved size in points; null means theme/unresolved." },
          "font_ascii": { "type": ["string", "null"] },
          "font_east_asia": { "type": ["string", "null"] },
          "bold": { "type": ["boolean", "null"] },
          "italic": { "type": ["boolean", "null"] },
          "style_name": { "type": ["string", "null"] },
          "align": { "type": ["string", "null"] },
          "has_image": { "type": "boolean" }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^t\\d+$" },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text", "empty"],
                "properties": {
                  "id": { "type": "string", "pattern": "^t\\d+r\\d+c\\d+$" },
                  "text": { "type": "string" },
                  "empty": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "description": "Guessed fillable positions. Heuristics, not a contract - confidence says how sure.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "current", "target", "confidence", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^s\\d+$" },
          "kind": { "enum": ["cell", "date-inline", "blank"] },
          "label": { "type": "string" },
          "current": { "type": "string" },
          "target": { "type": "object" },
          "locator": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "description": "Which heuristic fired, e.g. heuristic:label-right-cell." }
        }
      }
    },
    "figures": {
      "type": "object",
      "properties": { "count": { "type": "integer", "minimum": 0 } }
    },
    "stats": {
      "type": "object",
      "properties": {
        "paragraphs": { "type": "integer" },
        "tables": { "type": "integer" },
        "characters": { "type": "integer" }
      }
    }
  }
}
