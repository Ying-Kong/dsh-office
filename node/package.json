{
  "name": "@dsh-office/plugin",
  "version": "0.1.0",
  "description": "DSH plugin: deterministic OOXML template filling via declarative ops (Word first, Excel planned)",
  "type": "module",
  "main": "src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./core": "./src/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "docx",
    "ooxml",
    "template",
    "agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/core.test.mjs test/plugin.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/core.test.mjs test/plugin.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "entry": "src/plugin.mjs"
    }
  }
}
